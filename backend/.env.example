# Configuracao para desenvolvimento local com Docker Compose.
# Troque os valores de demonstracao antes de compartilhar ou publicar o servico.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=nassau_tickets
MYSQL_USER=nassau
MYSQL_PASSWORD=nassau
MYSQL_HOST_PORT=3308

JWT_SECRET_KEY=dev-secret-trocar-antes-de-compartilhar
ACCESS_TOKEN_EXPIRE_MINUTES=480
EXPEDIENTE_INICIO=7
EXPEDIENTE_FIM=17
NOT_ATTENDED_RATE=0.05
PANEL_LAST_CALLS=5

SEED_GESTOR_LOGIN=admin
SEED_GESTOR_SENHA=admin123
SEED_GESTOR_NOME=Gestor
SEED_ATENDENTE_LOGIN=atendente
SEED_ATENDENTE_SENHA=atendente123
SEED_ATENDENTE_NOME=Atendente
SEED_ATENDENTE_PERFIL=ATENDENTE
